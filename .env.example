POSTGRES_DB=cartridge_db
POSTGRES_USER=cartridge_user
POSTGRES_PASSWORD=cartridge_pass
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_HOST_PORT=5433
APP_HOST_BIND=127.0.0.1
APP_PORT=8080
FRONTEND_HOST_BIND=0.0.0.0
FRONTEND_PORT=3000
BACKUP_RETENTION_DAYS=14
APP_JWT_SECRET=change-this-secret-before-production-change-this-secret-before-production
APP_JWT_TTL_MINUTES=30
APP_HEALTHCHECK_USERNAME=admin
APP_HEALTHCHECK_PASSWORD=00000
APP_HALL_REQUEST_SLA_LOW_HOURS=72
APP_HALL_REQUEST_SLA_MEDIUM_HOURS=24
APP_HALL_REQUEST_SLA_HIGH_HOURS=8
APP_HALL_REQUEST_SLA_URGENT_HOURS=2
APP_HALL_REQUEST_ESCALATION_INTERVAL_MS=300000

# For manual backend run outside Docker (optional):
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/cartridge_db
SPRING_DATASOURCE_USERNAME=cartridge_user
SPRING_DATASOURCE_PASSWORD=cartridge_pass
SERVER_PORT=8080
